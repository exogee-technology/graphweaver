{
	"name": "@exogee/graphweaver-end-to-end",
	"version": "2.23.1",
	"description": "Graphweaver Test Suite",
	"license": "Apache-2.0",
	"scripts": {
		"build:types": "tsc --noEmit",
		"import-auth": "pnpm unpack && tsx ./scripts/import-auth.ts",
		"import-auth0": "pnpm unpack && tsx ./scripts/import-auth0.ts",
		"import-storage-provider": "pnpm unpack && tsx ./scripts/import-storage-provider.ts",
		"import-database-sqlite": "pnpm unpack && tsx ./scripts/import-sqlite.ts",
		"import-database-postgres": "pnpm unpack && . ./scripts/import-postgres.sh",
		"import-database-mysql": "pnpm unpack && . ./scripts/import-mysql.sh",
		"import-rest": "pnpm unpack && tsx ./scripts/import-rest.ts",
		"seed-postgres": "node ./scripts/seed-postgres.js",
		"start-server": "cd app && pnpm start",
		"dev-sqlite": "pnpm import-database-sqlite && pnpm start-server",
		"dev-postgres": "createdb gw && pnpm seed-postgres && pnpm import-database-postgres  && pnpm start-server",
		"dev-mysql": "pnpm import-database-mysql && pnpm start-server",
		"unpack": "tsx ./scripts/unpack.ts",
		"node-test": "node --import tsx --import ./node-test-setup.ts --test --test-concurrency=1 --test-force-exit",
		"test-auth": "pnpm node-test 'src/__tests__/api/auth/**/*.ts'",
		"test-metadata": "pnpm node-test 'src/__tests__/api/metadata/**/*.ts'",
		"test-mysql": "DATABASE=mysql pnpm node-test 'src/__tests__/api/mysql/**/*.ts'",
		"test-postgres": "DATABASE=postgres pnpm node-test 'src/__tests__/api/postgres/**/*.ts'",
		"test-sqlite": "dotenv -e .env.sqlite -- pnpm node-test 'src/__tests__/api/sqlite/**/*.ts'",
		"test-scalars": "pnpm node-test 'src/__tests__/api/scalars/**/*.ts'",
		"test-storage-provider": "pnpm node-test 'src/__tests__/api/storage-provider/**/*.ts'",
		"test-ui-auth": "pnpm exec playwright test ./auth",
		"test-ui:init": "pnpm exec playwright install",
		"test-ui:report": "pnpm exec playwright show-report",
		"test-ui-postgres": "pnpm exec playwright test ./postgres",
		"test-ui-rest": "pnpm exec playwright test ./rest",
		"test-ui-storage-provider": "pnpm exec playwright test ./storage-provider",
		"test-ui-sqlite": "pnpm exec playwright test ./sqlite",
		"test-fuzz": "pnpm node-test 'src/__tests__/fuzzer/tests/**/*.ts'",
		"version": "npm version --no-git-tag-version"
	},
	"dependencies": {
		"@exogee/graphweaver": "workspace:*",
		"@exogee/graphweaver-auth": "workspace:*",
		"@exogee/graphweaver-mikroorm": "workspace:*",
		"@exogee/graphweaver-scalars": "workspace:*",
		"@exogee/graphweaver-server": "workspace:*",
		"@exogee/graphweaver-storage-provider": "workspace:*",
		"@mikro-orm/core": "6.6.2",
		"@mikro-orm/postgresql": "6.6.2",
		"@mikro-orm/sqlite": "6.6.2",
		"dotenv-cli": "11.0.0",
		"ethers": "5.8.0",
		"graphql": "16.12.0",
		"graphweaver": "workspace:*",
		"jimp": "1.6.0",
		"promisify-child-process": "4.1.2",
		"web3-token": "1.0.6"
	},
	"devDependencies": {
		"@playwright/test": "1.59.1",
		"@simplewebauthn/types": "12.0.0",
		"@types/node": "24.10.0",
		"@types/pg": "8.15.4",
		"csv-parse": "6.1.0",
		"dotenv": "17.2.3",
		"expect": "30.4.1",
		"graphql-tag": "2.12.6",
		"http-server": "14.1.1",
		"mockdate": "3.0.5",
		"mysql2": "3.15.3",
		"pg": "8.16.3",
		"supertest-graphql": "1.1.4",
		"tsx": "4.20.6",
		"typescript": "7.0.2"
	},
	"keywords": [
		"graphql",
		"gql",
		"headless",
		"cms",
		"postgres",
		"postgresql",
		"mysql",
		"sqlite"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/exogee-technology/graphweaver.git"
	}
}
